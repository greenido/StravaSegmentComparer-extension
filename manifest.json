{
  "manifest_version": 3,
  "name": "Strava Segment Comparator",
  "version": "2.12",
  "description": "Compare two Strava activities segment by segment: see where you gained or lost time vs. a friend, an old ride or your PRs.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://www.strava.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/run-16.png",
      "48": "icons/run-48.png",
      "128": "icons/run-128-logo.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.strava.com/*"],
      "js": ["extractor.js", "content-script.js"]
    },
    {
      "matches": ["https://www.strava.com/activities/*"],
      "js": ["page-button.js"]
    }
  ],
  "icons": {
    "16": "icons/run-16.png",
    "48": "icons/run-48.png",
    "128": "icons/run-128-logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
